# Copy this file to backend_copy/.env and fill in your own values.
# backend_copy/.env is gitignored and must never be committed.

# Required for the document field extractor and all AI agents.
# Server-side only -- never expose this in Flutter or any client-side build.
OPENAI_API_KEY=<YOUR_OPENAI_API_KEY>

# Model used by the extraction and comparison agents.
OPENAI_MODEL=gpt-4.1-mini

# Optional. Sent only for models expected to support a deterministic seed.
# Defaults to 424242 if omitted.
OPENAI_EXTRACTION_SEED=424242
